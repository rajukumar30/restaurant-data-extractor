# Create a Google Maps Platform API key with Places API (New) enabled.
# Keep this key on the server. Never prefix it with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=replace_with_your_key

# Optional: Brave Search API key for additional web image discovery.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
BRAVE_SEARCH_API_KEY=replace_with_your_brave_search_key
